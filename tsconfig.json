{
  "compilerOptions": {
    "module": "node16",
    "target": "es2023",
    "moduleResolution": "node16",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,

    "allowJs": true,
    "checkJs": true,

    "outDir": "./dist",
    "types": ["node"],
    "lib": ["ESNext"]
  },
  "include": ["src/**/*.ts", "prisma/**/*", "lib/**/*", "prisma/script/**/*"],
  "exclude": ["node_modules", "test-db.ts"]
}
